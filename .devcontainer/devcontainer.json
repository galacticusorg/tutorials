{
    // A deliberately minimal container: Python + Jupyter and the editor
    // extensions, but NONE of the science packages. Installing Galacticus and
    // Dendros is part of the tutorial, so participants do that themselves.
    "name": "Galacticus Tutorial",
    "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
    // Galacticus evolves merger trees one-per-core, so more cores = a faster live
    // run. Default the Codespace to a 4-core machine (roughly halves the run vs 2).
    "hostRequirements": {
        "cpus": 4
    },
    "customizations": {
        "vscode": {
            // Auto-installed in the Codespace. See also .vscode/extensions.json
            // (recommendations for people who open the repo in local VS Code).
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                // Required for the Part 2 Plotly figure. The Jupyter extension
                // used to pull this in for us; it no longer reliably does, and
                // without it the 3D plot fails with "No renderer could be found
                // for mimetype application/vnd.plotly.v1+json". List it
                // explicitly rather than relying on the transitive install.
                "ms-toolsai.jupyter-renderers",
                "redhat.vscode-xml",
                // Adds Ctrl+K Ctrl+G in the parameter file: opens the docs for
                // the functionClass under the cursor (Part 1, Step 3). Needs
                // v0.3.0 or later; before that the command was .F90-only. It
                // pulls in the Fortran and RST extensions as dependencies,
                // which this tutorial does not otherwise need.
                "GalacticusOrg.galacticus-code"
            ]
        }
    },
    // Nothing here installs Galacticus or Dendros on purpose. We only make sure
    // pip/venv are ready so the very first tutorial command works cleanly.
    "postCreateCommand": "python -m pip install --upgrade pip"
}
